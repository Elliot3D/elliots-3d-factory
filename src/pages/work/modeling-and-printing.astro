---
import Layout from "../../layouts/Layout.astro";
import PhotoDropGrid from "../../components/PhotoDropGrid.astro";
---

<Layout
  title="3D modeling and printing — Elliots 3D factory"
  description="More of Elliots 3D factory modeling and printing work."
>
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <p class="text-sm uppercase tracking-[0.25em] text-ember">
      Elliots 3D factory
    </p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      3D modeling and printing
    </h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      Projects where I both modeled the design and printed the final piece.
    </p>

    <PhotoDropGrid
      storagePrefix="modeling-and-printing"
      count={2}
      seedImages={[
        {
          src: "/images/project-photo.jpg",
          alt: "Weather vane — 3D modeling and printing",
        },
      ]}
    />

    <a
      href="/#work"
      class="mt-10 inline-flex items-center text-sm text-ember hover:text-ember-dark"
    >
      ← Back to home
    </a>
  </div>
</Layout>
