---
import Layout from "../../layouts/Layout.astro";
import PhotoDropGrid from "../../components/PhotoDropGrid.astro";
---

<Layout
  title="3D modeling — Elliots 3D factory"
  description="More of Elliots 3D factory modeling work."
>
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <p class="text-sm uppercase tracking-[0.25em] text-ember">
      Elliots 3D factory
    </p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      3D modeling
    </h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      Digital models made from ideas, sketches, or descriptions.
    </p>

    <PhotoDropGrid storagePrefix="modeling" />

    <a
      href="/#work"
      class="mt-10 inline-flex items-center text-sm text-ember hover:text-ember-dark"
    >
      ← Back to home
    </a>
  </div>
</Layout>
