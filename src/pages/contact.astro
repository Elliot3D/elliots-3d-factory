---
import Layout from "../layouts/Layout.astro";

const FORMSPREE_ID = "myezzrak";
const formAction = `https://formspree.io/f/${FORMSPREE_ID}`;
---

<Layout
  title="Contact — Elliots 3D factory"
  description="Request a quote for 3D printing or modeling."
>
  <div class="mx-auto max-w-xl px-4 py-16 sm:px-6">
    <p class="text-sm uppercase tracking-[0.25em] text-ember">Enquire</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink">
      Request a quote
    </h1>
    <p class="mt-3 text-ink-muted">
      Describe the project as best you can. Include size, material, quantity and colour.
      
    </p>

    <form class="mt-10 space-y-6" action={formAction} method="POST">
      <input type="hidden" name="_subject" value="Elliots 3D factory quote request" />

      <div>
        <label for="name" class="block text-sm font-medium text-ink"
          >Name</label
        >
        <input
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          required
          class="mt-2 w-full rounded-md border border-line-strong bg-surface-raised px-3 py-2 text-ink outline-none ring-ember focus:border-ember focus:ring-2"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-ink"
          >Email</label
        >
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          class="mt-2 w-full rounded-md border border-line-strong bg-surface-raised px-3 py-2 text-ink outline-none ring-ember focus:border-ember focus:ring-2"
        />
      </div>

      <div>
        <label for="project-type" class="block text-sm font-medium text-ink"
          >Project type</label
        >
        <select
          id="project-type"
          name="project_type"
          required
          class="mt-2 w-full rounded-md border border-line-strong bg-surface-raised px-3 py-2 text-ink outline-none ring-ember focus:border-ember focus:ring-2"
        >
          <option value="" disabled selected>Choose one</option>
          <option value="print">3D printing</option>
          <option value="model">3D modeling</option>
          <option value="both">Printing and modeling</option>
        </select>
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-ink"
          >Project details</label
        >
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          placeholder="What do you need made? Any files, sizes, or dates?"
          class="mt-2 w-full resize-y rounded-md border border-line-strong bg-surface-raised px-3 py-2 text-ink outline-none ring-ember placeholder:text-ink-subtle focus:border-ember focus:ring-2"
        ></textarea>
      </div>

      <button
        type="submit"
        class="inline-flex w-full items-center justify-center rounded-md bg-ember px-5 py-2.5 text-sm font-medium text-zinc-50 hover:bg-ember-dark dark:text-zinc-950 sm:w-auto"
      >
        Send request
      </button>
    </form>
  </div>
</Layout>
