---
interface SeedImage {
  src: string;
  alt: string;
}

interface Props {
  /** Unique prefix so each page keeps its own saved photos */
  storagePrefix: string;
  count?: number;
  /** Photos already filled in at the start of the row */
  seedImages?: SeedImage[];
}

const { storagePrefix, count = 3, seedImages = [] } = Astro.props;
const slots = Array.from({ length: count }, (_, i) => `${storagePrefix}-${i + 1}`);
---

<ul class="mt-10 grid gap-4 sm:grid-cols-3">
  {
    seedImages.map((image) => (
      <li class="flex flex-col">
        <div class="flex aspect-[3/4] items-center justify-center overflow-hidden rounded-xl border border-line bg-surface-raised">
          <img
            src={image.src}
            alt={image.alt}
            class="h-full w-full object-cover"
            width="1200"
            height="1600"
            loading="lazy"
          />
        </div>
      </li>
    ))
  }
  {
    slots.map((id) => (
      <li class="flex flex-col" data-photo-slot={id}>
        <div class="photo-drop relative flex aspect-[3/4] items-center justify-center overflow-hidden rounded-xl border border-dashed border-line-strong bg-surface-raised transition-colors">
          <img
            data-photo-img
            alt="Work example"
            class="pointer-events-none hidden h-full w-full object-cover"
            width="1200"
            height="1600"
          />
          <label
            data-photo-dropzone
            class="absolute inset-0 z-10 flex cursor-pointer flex-col items-center justify-center gap-2 px-4 text-center transition-colors"
          >
            <span class="pointer-events-none text-sm font-medium text-ink"
              >Drop a photo here</span
            >
            <span class="pointer-events-none text-xs text-ink-subtle"
              >or click to choose a file</span
            >
            <input
              type="file"
              accept="image/jpeg,image/png,image/webp,image/gif,.png,.jpg,.jpeg"
              class="sr-only"
              data-photo-input
            />
          </label>
        </div>
      </li>
    ))
  }
</ul>

<script>
  import { bindAllPhotoSlots } from "../scripts/photo-drop";
  bindAllPhotoSlots();
</script>
