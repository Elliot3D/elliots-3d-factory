---
interface WorkImage {
  src: string;
  alt: string;
}

interface Props {
  images: WorkImage[];
}

const { images } = Astro.props;
---

<ul class="mt-10 grid gap-4 sm:grid-cols-3">
  {
    images.map((image) => (
      <li class="flex flex-col">
        <div class="flex aspect-[3/4] items-center justify-center overflow-hidden rounded-xl border border-line bg-surface-raised">
          <img
            src={image.src}
            alt={image.alt}
            class="h-full w-full object-cover"
            width="1200"
            height="1600"
            loading="lazy"
          />
        </div>
      </li>
    ))
  }
</ul>
